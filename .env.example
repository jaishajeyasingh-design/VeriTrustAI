# ==============================================================================
# VeriTrust AI — Environment Configuration Template
# ==============================================================================

# Server & Database Configuration (MERN Stack: MongoDB, Express, React, Node.js)
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/veritrustai

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Storage Directories (Controlled, non-public storage)
UPLOAD_DIR=backend/uploads
REPORTS_DIR=backend/uploads/reports

# Security & API Key (Never hardcode production credentials; use environment placeholders)
API_KEY=your_secure_api_key_here
VITE_API_KEY=your_secure_api_key_here

# Upload Constraints (Default: 15 MB)
MAX_UPLOAD_SIZE_BYTES=15728640

# Environment & AI Engine Flag
ENVIRONMENT=development
DEMO_MODE=false

# OCR Engine Path (Auto-detected if omitted; specify if non-standard installation)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
